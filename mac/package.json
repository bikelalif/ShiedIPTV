{
  "name": "shieldiptv-mac",
  "productName": "Shield IPTV Player",
  "version": "1.0.5",
  "description": "ShieldIPTV macOS Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "iptv",
    "player",
    "desktop",
    "macos"
  ],
  "author": "Bilal",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0"
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "build": {
    "appId": "com.shieldiptv.app",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "dmg": {
      "background": null,
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 150,
          "type": "file"
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
